{
  "expo": {
    "name": "ChemSmileAI",
    "slug": "ChemSmileAI",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/App-logo.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sakshamraj1.ChemSmileAI",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0b0909",
        "foregroundImage": "./assets/App-logo.png"
      },
      "package": "com.sakshamraj1.ChemSmileAI"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0b0909",
          "image": "./assets/logo-startup.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ]
    ],
    "web": {
      "favicon": "./assets/App-logo.png"
    },
    "extra": {
      "eas": {
        "projectId": "d6cb5774-6ad6-4a32-844c-f26f915ba165"
      }
    }
  }
}
